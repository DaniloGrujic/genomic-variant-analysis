{
    "family":  "variant-api-task",
    "taskRoleArn":  "arn:aws:iam::925645278815:role/variant-api-ecs-task-role",
    "executionRoleArn":  "arn:aws:iam::925645278815:role/variant-api-ecs-execution-role",
    "networkMode":  "awsvpc",
    "containerDefinitions":  [
                                 {
                                     "name":  "variant-api",
                                     "image":  "925645278815.dkr.ecr.eu-north-1.amazonaws.com/variant-api:latest",
                                     "cpu":  0,
                                     "portMappings":  [
                                                          {
                                                              "containerPort":  8000,
                                                              "hostPort":  8000,
                                                              "protocol":  "tcp"
                                                          }
                                                      ],
                                     "essential":  true,
                                     "environment":  [
                                                         {
                                                             "name":  "S3_BUCKET_NAME",
                                                             "value":  "variant-api-storage-12345"
                                                         },
                                                         {
                                                             "name":  "STORAGE_BACKEND",
                                                             "value":  "s3"
                                                         },
                                                         {
                                                             "name":  "AWS_REGION",
                                                             "value":  "eu-north-1"
                                                         }
                                                     ],
                                     "mountPoints":  [

                                                     ],
                                     "volumesFrom":  [

                                                     ],
                                     "secrets":  [
                                                     {
                                                         "name":  "DATABASE_URL",
                                                         "valueFrom":  "arn:aws:secretsmanager:eu-north-1:925645278815:secret:variant-api/database-url-MgzHOA"
                                                     }
                                                 ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/variant-api",
                                                                              "awslogs-region":  "eu-north-1",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          }
                                                          },
                                     "systemControls":  [

                                                        ]
                                 }
                             ],
    "volumes":  [

                ],
    "placementConstraints":  [

                             ],
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "256",
    "memory":  "512",
    "runtimePlatform":  {
                            "cpuArchitecture":  "X86_64",
                            "operatingSystemFamily":  "LINUX"
                        }
}
